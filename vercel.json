{
  "crons": [
    {
      "path": "/api/orders?action=sync",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/sessions?action=sync",
      "schedule": "0 11 * * *"
    }
  ],
  "functions": {
    "api/transactions.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ]
}
