{
  "crons": [
    {
      "path": "/api/orders?action=sync&days=14",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/sessions?action=sync",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/transactions?action=sync-v2024",
      "schedule": "0 10 3 * *"
    },
    {
      "path": "/api/adspend?action=sync-request",
      "schedule": "10 10 3 * *"
    },
    {
      "path": "/api/adspend?action=sync-collect",
      "schedule": "0 12 3 * *"
    },
    {
      "path": "/api/shipping?action=sync",
      "schedule": "0 13 3 * *"
    },
    {
      "path": "/api/orders?action=cron-daily-request",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/orders?action=cron-collect&slot=1",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/orders?action=cron-collect&slot=2",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/orders?action=cron-collect&slot=3",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/orders?action=cron-data-check",
      "schedule": "0 20 * * *"
    }
  ],
  "functions": {
    "api/orders.js": {
      "maxDuration": 300
    },
    "api/transactions.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ]
}
